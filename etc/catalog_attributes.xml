<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Catalog:etc/catalog_attributes.xsd">
    <!-- Loaded with a product put in the cart: GraphQL's addProductsToCart reads only this group's attributes, and
         Observer\PrepareOptions needs the amounts to tell a gift card. -->
    <group name="quote_item">
        <attribute name="zero_giftcard_amounts"/>
    </group>
</config>
