{
    "name": "zerofront/module-zero-gift-card",
    "description": "Zero for Magento Open Source: gift cards: sold as a product, emailed once paid, spent at checkout like money.",
    "type": "magento2-module",
    "version": "1.3.4",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "gift-card",
        "gift-certificate"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-catalog": "*",
        "magento/module-catalog-rule": "*",
        "magento/module-checkout": "*",
        "magento/module-config": "*",
        "magento/module-eav": "*",
        "magento/module-email": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-tax": "*",
        "zerofront/module-zero-checkout": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-gift-card": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\GiftCard\\": ""
        }
    }
