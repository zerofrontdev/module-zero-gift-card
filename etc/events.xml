<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Buying a card: its amount and recipient become the cart line's option and price. -->
    <event name="catalog_product_type_prepare_full_options">
        <observer name="zero_giftcard_options" instance="Zero\GiftCard\Observer\PrepareOptions"/>
    </event>
    <!-- Paid: the cards are made and emailed. -->
    <event name="sales_order_invoice_pay">
        <observer name="zero_giftcard_issue" instance="Zero\GiftCard\Observer\IssueOnInvoice"/>
    </event>
    <event name="sales_order_invoice_save_commit_after">
        <observer name="zero_giftcard_send" instance="Zero\GiftCard\Observer\SendOnCommit"/>
    </event>
    <!-- Paying with cards: taken when the order is placed, given back if it fails or is cancelled, refunded to them. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="zero_giftcard_use" instance="Zero\GiftCard\Observer\UseOnOrder"/>
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="zero_giftcard_failed" instance="Zero\GiftCard\Observer\ReturnOnFailure"/>
    </event>
    <event name="order_cancel_after">
        <observer name="zero_giftcard_cancel" instance="Zero\GiftCard\Observer\ReturnOnCancel"/>
        <!-- Defensive: cards exist only for invoiced qty, which a cancel doesn't touch. -->
        <observer name="zero_giftcard_disable_canceled" instance="Zero\GiftCard\Observer\DisableRefundedCards"/>
    </event>
    <event name="sales_order_invoice_register">
        <observer name="zero_giftcard_invoiced" instance="Zero\GiftCard\Observer\InvoiceRegister"/>
    </event>
    <event name="sales_order_creditmemo_refund">
        <observer name="zero_giftcard_refund" instance="Zero\GiftCard\Observer\RefundToCards"/>
        <!-- A refunded gift card line: the cards it made that nobody used are turned off. -->
        <observer name="zero_giftcard_disable_refunded" instance="Zero\GiftCard\Observer\DisableRefundedCards"/>
    </event>
</config>
